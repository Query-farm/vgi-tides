# NOAA fixture assertions over stdio, launch and HTTP.
require vgi

require-env TIDES_WORKER

statement ok
INSTALL icu FROM core;

statement ok
LOAD icu;

statement ok
SET TimeZone='UTC';

statement ok
ATTACH 'tides' (TYPE vgi, LOCATION '{TIDES_WORKER}');

# stations
query TT
SELECT station_id, name FROM tides.main.stations() ORDER BY station_id;
----
8518750	The Battery
9414290	San Francisco

# tide UTC and height
query TITT
SELECT strftime(time, '%Y-%m-%d %H:%M:%S'), CAST(round(height_m*100) AS INTEGER), event_type, datum FROM tides.main.tide_predictions('8518750','2026-01-01','2026-01-01') ORDER BY time;
----
2026-01-01 00:00:00	120	H	MLLW
2026-01-01 06:00:00	20	L	MLLW
2026-01-01 12:00:00	150	H	MLLW
2026-01-01 18:00:00	10	L	MLLW

# multiple request batches
query III
SELECT count(*), count(DISTINCT time), count(DISTINCT source_url) FROM tides.main.tide_predictions('8518750','2026-01-01','2026-01-16');
----
64	64	3

# named interval and datum
query IT
SELECT count(*), min(datum) FROM tides.main.tide_predictions('8518750','2026-01-01','2026-01-01', step := 'h', datum := 'MSL');
----
24	MSL

# observations preserve null zero QC
query IIITT
SELECT count(*),count(height_m), CAST(round(min(height_m)*100) AS INTEGER), min(quality), min(flags) FROM tides.main.water_levels('8518750','2026-01-01','2026-01-01');
----
4	3	-30	p	1,0,0,0

# current predictions signed conversion
query TIII
SELECT event_type, CAST(round(velocity_major_mps*1000) AS INTEGER), bin, CAST(depth_m*10 AS INTEGER) FROM tides.main.current_predictions('ACT0956','2026-01-01','2026-01-01', bin := 2) ORDER BY time;
----
flood	250	2	18
slack	0	2	18
ebb	-125	2	18
slack	0	2	18

# all-bin currents and daily batches
query III
SELECT count(*),count(DISTINCT source_url), CAST(round(sum(speed_mps)*100) AS INTEGER) FROM tides.main.currents('cb0102','2026-01-01','2026-01-02');
----
4	2	150

# bin metadata
query III
SELECT bin, CAST(depth_m*10 AS INTEGER), qc_flag FROM tides.main.current_bins('cb0102') ORDER BY bin;
----
1	18	1
2	36	0

# empty observations
query I
SELECT count(*) FROM tides.main.water_levels('0000000','2026-01-01','2026-01-02');
----
0

# empty bins
query I
SELECT count(*) FROM tides.main.current_bins('0000000');
----
0

# join predictions and stations
query TI
SELECT s.name, count(*) FROM tides.main.stations() s JOIN tides.main.tide_predictions('8518750','2026-01-01','2026-01-01') p USING(station_id) GROUP BY s.name;
----
The Battery	4

# provenance and timestamp types
query IT
SELECT CAST(bool_and(fetched_at IS NOT NULL AND source_url LIKE '%time_zone=gmt%') AS INTEGER), typeof(min(time)) FROM tides.main.water_levels('8518750','2026-01-01','2026-01-01');
----
1	TIMESTAMP WITH TIME ZONE

statement error
SELECT * FROM tides.main.water_levels(NULL,'2026-01-01','2026-01-01');
----
<REGEX>:.*

statement error
SELECT * FROM tides.main.tide_predictions('8518750','2026-02-30','2026-03-01');
----
Invalid date

statement error
SELECT * FROM tides.main.tide_predictions('8518750','2026-01-02','2026-01-01');
----
end_date

statement error
SELECT * FROM tides.main.tide_predictions('8518750','2026-01-01','2026-01-01', step := '2');
----
<REGEX>:.*

statement error
SELECT * FROM tides.main.tide_predictions('9999999','2026-01-01','2026-01-01');
----
Invalid station

statement error
SELECT * FROM tides.main.water_levels('8888888','2026-01-01','2026-01-01');
----
array

statement error
SELECT * FROM tides.main.water_levels('HTTP001','2026-01-01','2026-01-01');
----
HTTP 404


query TT
SELECT sql_function, output_units FROM tides.main.products WHERE output_units = 'm/s' ORDER BY sql_function;
----
current_predictions	m/s
currents	m/s

# composed: daily surge residual (water_levels x tide_predictions)
query TRRI
SELECT CAST(o.time AS DATE) AS obs_day, round(max(o.height_m - p.height_m), 3) AS max_residual_m, round(min(o.height_m - p.height_m), 3) AS min_residual_m, count(o.height_m) AS samples FROM tides.main.water_levels('8518750', '2026-01-01', '2026-01-07') AS o JOIN tides.main.tide_predictions('8518750', '2026-01-01', '2026-01-07', step := '6') AS p USING (time) GROUP BY obs_day ORDER BY obs_day;
----
2026-01-01	0.0	-1.5	3
2026-01-02	0.0	-1.5	3
2026-01-03	0.0	-1.5	3
2026-01-04	0.0	-1.5	3
2026-01-05	0.0	-1.5	3
2026-01-06	0.0	-1.5	3
2026-01-07	0.0	-1.5	3

# composed: predicted high tides vs observed peak
query TRRR
SELECT p.time AS predicted_high, p.height_m AS predicted_m, max(o.height_m) AS observed_peak_m, round(max(o.height_m) - p.height_m, 3) AS surge_m FROM tides.main.tide_predictions('8518750', '2026-01-01', '2026-01-03') AS p JOIN tides.main.water_levels('8518750', '2026-01-01', '2026-01-03') AS o ON o.time BETWEEN p.time - INTERVAL 1 HOUR AND p.time + INTERVAL 1 HOUR WHERE p.event_type = 'H' GROUP BY p.time, p.height_m ORDER BY p.time;
----
2026-01-01 00:00:00+00	1.2	1.2	0.0
2026-01-01 12:00:00+00	1.5	NULL	NULL
2026-01-02 00:00:00+00	1.2	1.2	0.0
2026-01-02 12:00:00+00	1.5	NULL	NULL
2026-01-03 00:00:00+00	1.2	1.2	0.0
2026-01-03 12:00:00+00	1.5	NULL	NULL

# composed: speed by sensor depth (currents x current_bins)
query IRRR
SELECT b.bin, b.depth_m, round(avg(c.speed_mps), 3) AS mean_speed_mps, round(max(c.speed_mps), 3) AS max_speed_mps FROM tides.main.currents('cb0102', '2026-01-01', '2026-01-01') AS c JOIN tides.main.current_bins('cb0102') AS b USING (bin) GROUP BY b.bin, b.depth_m ORDER BY b.bin;
----
1	1.8	0.25	0.25
2	3.6	0.5	0.5

# composed: predicted current events vs observed speed
query TTRRI
SELECT p.time, p.event_type, round(abs(p.velocity_major_mps), 2) AS predicted_speed_mps, round(avg(o.speed_mps), 2) AS observed_speed_mps, count(o.speed_mps) AS observations FROM tides.main.current_predictions('cb0102', '2026-01-01', '2026-01-01', bin := 4) AS p JOIN tides.main.currents('cb0102', '2026-01-01', '2026-01-01', bin := 4) AS o ON o.time BETWEEN p.time - INTERVAL 15 MINUTE AND p.time + INTERVAL 15 MINUTE GROUP BY p.time, p.event_type, p.velocity_major_mps ORDER BY p.time;
----
2026-01-01 00:00:00+00	flood	0.25	1.0	1

# current-prediction stations are listed once per depth bin
query TI
SELECT station_id, bin FROM tides.main.stations(station_kind := 'currentpredictions') ORDER BY bin;
----
cb0102	4
cb0102	9

# a NOAA 400 keeps its JSON error message
statement error
SELECT count(*) FROM tides.main.current_predictions('cb0102', '2026-01-01', '2026-01-01', bin := 99);
----
Available bin number of cb0102: 1, 2
