#!/bin/sh
# Start the worker. DuckDB runs this as the ATTACH LOCATION:
#   ATTACH 'tides' (TYPE vgi, LOCATION '/abs/path/to/bin/vgi-tides-worker');
# Flags pass through: --http [--host H] [--port N], --unix PATH, --debug.
here="$(cd "$(dirname "$0")" && pwd)"
exec bun run "$here/../src/worker.ts" "$@"
